# Any OpenAI-compatible chat completions API. OpenRouter is the default.
LLM_API_KEY=
# e.g. https://api.openai.com/v1, https://api.deepseek.com/v1, https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
# Model names follow the provider's own naming.
LLM_MODEL=anthropic/claude-haiku-5.5
LLM_PARSE_MODEL=
LLM_SOLVE_MODEL=
TEACHBACK_DB=data/teachback.db
